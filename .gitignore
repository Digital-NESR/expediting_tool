# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration data files
scripts/data/

# Source workbooks and documents dropped in the repo root while building content.
# The content itself is committed (database/content, src/lib/learning-hub/worksheets); these are
# the originals they were generated from, and they belong with the author rather than in git.
# Ignored rather than deleted: they are somebody's working copy, not build output.
/*.xlsx
/*.docx
/~$*
