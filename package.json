{
  "name": "expediting_tool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "migrate:dry": "node --env-file-if-exists=.env.local scripts/migrate.mjs --dry",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "laptop:db:seed": "node --env-file=.env.local scripts/laptop-seed-data.mjs",
    "laptop:cost-centers:seed": "node scripts/seed-laptop-cost-centers.mjs",
    "sns:db:init": "node scripts/sns-init-db.mjs",
    "soa:countries:seed": "node --env-file-if-exists=.env scripts/soa-seed-countries.mjs",
    "delegation:db:init": "node scripts/delegation-init-db.mjs",
    "sns:seed:approvers": "node scripts/sns-seed-approvers.mjs",
    "sns:test:reminders": "node scripts/sns-reminder-sql-test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
